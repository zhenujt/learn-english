{
  "servers": {
    "google-docs-app-carter": {
      "command": "npx",
      "args": ["-y", "@a-bonus/google-docs-mcp@1.11.3"],
      "env": {
        "GOOGLE_CLIENT_ID": "${input:googleClientId}",
        "GOOGLE_CLIENT_SECRET": "${input:googleClientSecret}",
        "MCP_TOOL_GROUPS": "docs",
        "GOOGLE_MCP_PROFILE": "personal"
      }
    }
  },
  "inputs": [
    {
      "type": "promptString",
      "id": "googleClientId",
      "description": "Google OAuth client ID"
    },
    {
      "type": "promptString",
      "id": "googleClientSecret",
      "description": "Google OAuth client secret",
      "password": true
    }
  ]
}